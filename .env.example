# ---------------------------------------------------------------------------
# LiteLLM (Upstream)
# ---------------------------------------------------------------------------
# Harness nativ auf dem Mac: http://localhost:4000
# Harness in Docker:         http://host.docker.internal:4000 (oder http://litellm:4000 im selben Netz)
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-dein-litellm-key

# Modelle (Namen wie in LiteLLM konfiguriert), kommagetrennt.
# In Open WebUI erscheinen sie als "brain/<modell>" und "incognito/<modell>".
CHAT_MODELS=gpt-5

# Modell für Hintergrundaufgaben (Dreaming, Zusammenfassungen).
# Leer = erstes Modell aus CHAT_MODELS. Ein schnelleres/günstigeres Modell reicht oft.
BACKGROUND_MODEL=

# Optional: Embedding-Modell in LiteLLM (z. B. text-embedding-3-small oder bge-m3).
# Leer = nur Volltextsuche. Nach späterem Aktivieren/Wechseln: POST /memory/reembed
EMBEDDING_MODEL=

# Upstream-API für Chats: chat (/v1/chat/completions) oder responses (/v1/responses).
# Die Responses API erlaubt Tools + Reasoning gleichzeitig und liefert Reasoning-Zusammenfassungen.
UPSTREAM_API=chat
# Alternativ nur bestimmte Modelle über /v1/responses schicken (kommagetrennt)
RESPONSES_MODELS=
# Reasoning-Zusammenfassung anzeigen (auto | concise | detailed | leer = aus)
RESPONSES_REASONING_SUMMARY=auto
# Wenn ein Modell Tools + reasoning_effort auf /v1/chat/completions ablehnt:
# use_responses:    automatisch auf /v1/responses wechseln (Standard)
# prefer_reasoning: ohne Tools antworten
# prefer_tools:     reasoning_effort=none setzen
REASONING_TOOLS_CONFLICT=use_responses

# ---------------------------------------------------------------------------
# Harness
# ---------------------------------------------------------------------------
# Optionaler Schutz der API (die App fragt dann einmal danach). Empfohlen, wenn Open WebUI
# oder andere Programme auf den Harness zugreifen. Leer = kein Key (Harness hört nur auf localhost).
HARNESS_API_KEY=

# Wie der Assistent dich nennt
USER_NAME=Dein Name
TIMEZONE=Europe/Berlin
DB_PATH=./data/brain.db

# Obsidian-Export des Gedächtnisses (leer = aus), z. B. ~/Documents/SecondBrain
EXPORT_DIR=

# ---------------------------------------------------------------------------
# Tools & MCP
# ---------------------------------------------------------------------------
# Freigabe-Modus (pro Chat änderbar mit /plan, /ask, /auto):
#   plan – nur lesen · ask – Änderungen brauchen dein „ok“ · auto – alles ohne Rückfrage
PERMISSION_MODE=ask
# MCP-Server im Format von Claude Code (Beispiele: config/mcp.example.json)
MCP_CONFIG=./config/mcp.json
# Secrets für ${VAR} in der MCP-Config
MCP_SECRETS=./config/secrets.env
MCP_LOG_DIR=./data/logs/mcp
# Ab so vielen Tools bekommt das Modell eine Tool-Suche statt aller Schemas
TOOL_SEARCH_THRESHOLD=40

# ---------------------------------------------------------------------------
# Gedächtnis (Standardwerte sind sinnvoll)
# ---------------------------------------------------------------------------
# Chats werden nach so vielen Minuten Ruhe verarbeitet („Dreaming“)
DREAM_IDLE_MINUTES=15
# Budgets im Systemprompt
SAVED_MEMORIES_TOKEN_BUDGET=1500
RECENT_CHATS_COUNT=25
RECENT_CHATS_TOKEN_BUDGET=1500
SUMMARY_MAX_WORDS=500
CONTEXT_TOKEN_BUDGET=2500
MAX_CONTEXT_FACTS=25
PROFILE_REBUILD_EVERY=8
SHOW_TOOL_ACTIVITY=true
# Falls dein Modell response_format=json_object nicht unterstützt: false
JSON_MODE=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Dokumente (Uploads)
# ---------------------------------------------------------------------------
# Bis zu dieser Größe steht ein Dokument komplett im Chat, darüber liest der Assistent per read_document nach
DOC_INLINE_TOKENS=15000
# Seiten mit Grafiken/Scans zusätzlich als Bild ans Modell (false bei Modellen ohne Vision)
DOC_VISION=true
DOC_MAX_PAGE_IMAGES=6
# PDFs zusätzlich im Original schicken (nur wenn Modell/Anbieter PDF-Eingaben versteht)
PDF_NATIVE=false
MAX_UPLOAD_MB=50
