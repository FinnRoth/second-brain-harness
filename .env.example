# ---------------------------------------------------------------------------
# LiteLLM (Upstream)
# ---------------------------------------------------------------------------
# Von Docker aus erreicht man Dienste auf dem Mac über host.docker.internal.
# Läuft LiteLLM im selben Docker-Netz, z. B. http://litellm:4000
LITELLM_BASE_URL=http://host.docker.internal:4000
LITELLM_API_KEY=sk-dein-litellm-key

# Modelle (Namen wie in LiteLLM konfiguriert), kommagetrennt.
# In Open WebUI erscheinen sie als "brain/<modell>" und "incognito/<modell>".
CHAT_MODELS=gpt-5

# Modell für Hintergrundaufgaben (Extraktion, Profil, Zusammenfassungen).
# Leer = erstes Modell aus CHAT_MODELS. Ein schnelleres/günstigeres Modell reicht oft.
BACKGROUND_MODEL=

# Optional: Embedding-Modell in LiteLLM (z. B. text-embedding-3-small oder bge-m3).
# Leer = nur Volltextsuche. Nach späterem Aktivieren/Wechseln: POST /memory/reembed
EMBEDDING_MODEL=

# ---------------------------------------------------------------------------
# Harness
# ---------------------------------------------------------------------------
# Schlüssel, mit dem sich Open WebUI beim Harness anmeldet (frei wählen!)
HARNESS_API_KEY=wähle-einen-langen-zufälligen-schlüssel

# Wie der Assistent dich nennt
USER_NAME=Dein Name
TIMEZONE=Europe/Berlin

# Feintuning (Standardwerte sind sinnvoll)
CONTEXT_TOKEN_BUDGET=2500
MAX_CONTEXT_FACTS=25
SHOW_TOOL_ACTIVITY=true
# Manche Reasoning-Modelle akzeptieren keine Tools zusammen mit reasoning_effort.
# prefer_reasoning: dann ohne Gedächtnis-Tools antworten (automatisches Erinnern/Lernen bleibt)
# prefer_tools:     dann reasoning_effort=none setzen und Tools behalten
REASONING_TOOLS_CONFLICT=prefer_reasoning
PROFILE_REBUILD_EVERY=8
SUMMARY_IDLE_MINUTES=20
# Falls dein Modell response_format=json_object nicht unterstützt: false
JSON_MODE=true
LOG_LEVEL=INFO
